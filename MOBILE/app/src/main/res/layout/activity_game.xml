<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:text="[ CAST SPELL ]"
        android:textColor="@color/pixel_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/spellButton1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:layout_rowWeight="1"
            android:background="@drawable/pixel_button_1"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            android:text="SPELL I"
            android:textColor="@color/pixel_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/spellButton2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:layout_rowWeight="1"
            android:background="@drawable/pixel_button_2"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            android:text="SPELL II"
            android:textColor="@color/pixel_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/spellButton3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:layout_rowWeight="1"
            android:background="@drawable/pixel_button_3"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            android:text="SPELL III"
            android:textColor="@color/pixel_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/spellButton4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:layout_rowWeight="1"
            android:background="@drawable/pixel_button_4"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            android:text="SPELL IV"
            android:textColor="@color/pixel_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    </GridLayout>

</LinearLayout>
