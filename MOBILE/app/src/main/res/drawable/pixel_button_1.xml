<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- pixel drop shadow (bottom-right offset) -->
    <item android:left="6dp" android:top="6dp">
        <shape>
            <solid android:color="#000000" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <!-- button face -->
    <item android:bottom="6dp" android:right="6dp">
        <shape>
            <solid android:color="#8b1a1a" />
            <stroke android:width="3dp" android:color="#000000" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <!-- top-left highlight (pixel art inner light) -->
    <item android:bottom="12dp" android:left="3dp" android:right="12dp" android:top="3dp">
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#e05050" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>
