<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@global-styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jtjmpm.desktop.controller.StartController">
<padding>
    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
</padding>

<Label text="we need to talk" styleClass="title-purple"/>

<ImageView fx:id="qrCodeImageView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true"/>

<VBox alignment="CENTER" spacing="10.0">
    <Label fx:id="phoneStatusLabel" text="Phone: Waiting..." styleClass="info-text"/>
    <Label fx:id="apiStatusLabel" text="API: Waiting..." styleClass="info-text"/>
</VBox>

<Button fx:id="startButton" text="Start" onAction="#onStartClicked" prefWidth="120.0" prefHeight="40.0" styleClass="action-button"/>

</VBox>
