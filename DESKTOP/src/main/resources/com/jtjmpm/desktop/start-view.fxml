<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0"
      stylesheets="@global-styles.css"
      style="-fx-background-color: #0f0f23;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jtjmpm.desktop.controller.StartController">

    <padding>
        <Insets bottom="48" left="48" right="48" top="48"/>
    </padding>

    <!-- Title -->
    <Label text="[ WE NEED TO TALK ]" styleClass="pixel-title"/>

    <!-- QR code -->
    <ImageView fx:id="qrCodeImageView" fitHeight="200.0" fitWidth="200.0"
               pickOnBounds="true" preserveRatio="true"/>

    <!-- Divider -->
    <Region styleClass="pixel-divider" maxWidth="Infinity"/>

    <!-- Connection status -->
    <VBox alignment="CENTER" spacing="8.0">
        <Label fx:id="phoneStatusLabel" text="PHONE  :  WAITING..."  styleClass="pixel-status"/>
        <Label fx:id="apiStatusLabel"   text="SERVER :  WAITING..."  styleClass="pixel-status"/>
    </VBox>

    <!-- Region to push button down a bit -->
    <Region prefHeight="8"/>

    <!-- Start button -->
    <Button fx:id="startButton" text="[ START ]" onAction="#onStartClicked"
            maxWidth="Infinity" styleClass="pixel-button"/>

</VBox>
