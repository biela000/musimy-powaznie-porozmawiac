<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="16"
      stylesheets="@global-styles.css"
      style="-fx-background-color: #0f0f23;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jtjmpm.desktop.controller.ReadyController"
      prefWidth="720" prefHeight="520">

    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <!-- Lobby heading -->
    <Label fx:id="lobbyLabel" text="[ WAITING FOR PLAYERS... ]" styleClass="pixel-subtitle"/>

    <Region styleClass="pixel-divider" maxWidth="Infinity"/>

    <!-- Spell selection prompt -->
    <Label text="SELECT YOUR SPELLS  ( choose 4 )" styleClass="pixel-label"/>

    <!-- Spell cards grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="pixel-scroll-pane">
        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
        <TilePane fx:id="spellsContainer" hgap="14" vgap="14" alignment="CENTER"
                  style="-fx-background-color: transparent;"/>
    </ScrollPane>

    <Region styleClass="pixel-divider" maxWidth="Infinity"/>

    <!-- Player ready statuses -->
    <HBox alignment="CENTER" spacing="60">
        <Label fx:id="hostStatusLabel"  text="HOST   :  NOT READY" styleClass="pixel-status-not-ready"/>
        <Label fx:id="enemyStatusLabel" text="ENEMY  :  NOT READY" styleClass="pixel-status-not-ready"/>
    </HBox>

    <!-- Ready button -->
    <Button fx:id="readyButton" text="[ READY ]" onAction="#onReady"
            maxWidth="Infinity" disable="true" styleClass="pixel-button"/>

    <!-- Starting soon hint -->
    <Label fx:id="startingSoonLabel" text="" styleClass="pixel-status" maxWidth="Infinity"
           style="-fx-alignment: center;"/>

</VBox>
