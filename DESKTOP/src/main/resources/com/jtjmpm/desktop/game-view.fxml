<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<AnchorPane fx:id="mainPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@global-styles.css"
            fx:controller="com.jtjmpm.desktop.controller.GameController"
            prefHeight="768.0" prefWidth="1366.0"
            style="-fx-background-image: url('/com/jtjmpm/desktop/NightForest/Image.png'); -fx-background-size: cover; -fx-background-position: center bottom;">

    <!-- Title + lobby info -->
    <VBox alignment="CENTER" spacing="10.0" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Label text="Arena - 1vs1 Battle" styleClass="title-white-shadow"/>
    </VBox>

    <!-- Back to Menu (top-right) -->
    <Button text="Menu" onAction="#onBackToMenu" styleClass="action-button"
            AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0"/>

    <!-- Host HP/Mana panel (top-left) -->
    <VBox alignment="TOP_LEFT" AnchorPane.topAnchor="100.0" AnchorPane.leftAnchor="20.0">
        <fx:include fx:id="hostPanel" source="player-panel.fxml" />
    </VBox>

    <!-- Enemy HP/Mana panel (top-right) -->
    <VBox alignment="TOP_RIGHT" AnchorPane.topAnchor="100.0" AnchorPane.rightAnchor="20.0">
        <fx:include fx:id="enemyPanel" source="player-panel.fxml" />
    </VBox>

    <!-- Wizard images -->
    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="100.0">
        <ImageView fx:id="hostWizardImage" fitWidth="550" fitHeight="550" preserveRatio="true" />
        <ImageView fx:id="hostEffectImage" fitWidth="220" fitHeight="220" preserveRatio="true" />
    </StackPane>

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="100.0">
        <ImageView fx:id="enemyWizardImage" fitWidth="550" fitHeight="550" preserveRatio="true" />
        <ImageView fx:id="enemyEffectImage" fitWidth="220" fitHeight="220" preserveRatio="true" />
    </StackPane>

    <!-- Centered combat panel (pattern to draw + player's drawn gesture) -->
    <VBox alignment="CENTER" spacing="10.0"
          AnchorPane.topAnchor="80.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <Label text="DRAW THIS" styleClass="panel-title"/>
        <HBox alignment="CENTER" spacing="50.0">
            <VBox alignment="CENTER" spacing="4.0" styleClass="canvas-container">
                <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                <Canvas fx:id="patternCanvas" width="240.0" height="240.0"/>
            </VBox>
            <VBox alignment="CENTER" spacing="4.0" styleClass="canvas-container">
                <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                <Canvas fx:id="gestureCanvas" width="240.0" height="240.0"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Spell loadout display (bottom center) -->
    <HBox alignment="CENTER" spacing="40.0"
          AnchorPane.bottomAnchor="18.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <Label fx:id="spell1Label" text="1  —" styleClass="spell-slot-label"/>
        <Label fx:id="spell2Label" text="2  —" styleClass="spell-slot-label"/>
        <Label fx:id="spell3Label" text="3  —" styleClass="spell-slot-label"/>
        <Label fx:id="spell4Label" text="4  —" styleClass="spell-slot-label"/>
    </HBox>

</AnchorPane>
