<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="6.0"
      stylesheets="@player-panel.css"
      fx:controller="com.jtjmpm.desktop.controller.PlayerPanelController">

    <padding><Insets top="8" bottom="8" left="8" right="8"/></padding>

    <ProgressBar fx:id="hpBar" progress="1.0" prefWidth="200.0" styleClass="hp-bar"/>
    <Label fx:id="hpLabel" text="HP: 200/200" styleClass="stat-label"/>

    <ProgressBar fx:id="manaBar" progress="1.0" prefWidth="200.0" styleClass="mana-bar"/>
    <Label fx:id="manaLabel" text="Mana: 100/100" styleClass="stat-label"/>

    <Label fx:id="winsLabel" text="○  ○" styleClass="wins-label"/>

    <VBox styleClass="effects-container" prefHeight="200.0" prefWidth="200.0">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox fx:id="activeEffectsContainer" alignment="CENTER" spacing="4.0" style="-fx-background-color: transparent;">
                <padding><Insets top="4" bottom="4" left="8" right="8"/></padding>
            </VBox>
        </ScrollPane>
    </VBox>

</VBox>
